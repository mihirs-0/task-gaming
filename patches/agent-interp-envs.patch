     Returns:
         Tuple of (return_code, combined_stdout_stderr_output).
     """
+    # subprocess.run(shell=True, timeout=..., stdout=PIPE) does not reliably
+    # time out: it kills only the /bin/sh, while any grandchild it spawned keeps
+    # the pipe's write end open, so the follow-up read blocks forever. A single
+    # `grep -R ... ..` (recursing above the workspace into /proc) hung a rollout
+    # for 30+ minutes despite this 30s cap. Run the command in its own session
+    # and kill the whole process group instead.
+    proc = subprocess.Popen(
+        command,
+        shell=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        close_fds=True,
+        start_new_session=True,
+    )
